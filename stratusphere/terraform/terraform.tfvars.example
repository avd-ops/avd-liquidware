namePrefix   = "ssux"
location     = "eastus2"
tags         = { environment = "lab" }
imageVersion = "latest"

deployHub    = true
hubImagePlan = "set-hub-image-plan"
hubVmSize    = "Standard_D4s_v5"

deployDatabase    = false
databaseImagePlan = ""

collectorCount     = 0
collectorImagePlan = ""

peerVirtualNetworkResourceId = ""
deployBastion                = true
keyVaultReaderObjectId       = "00000000-0000-0000-0000-000000000000"
